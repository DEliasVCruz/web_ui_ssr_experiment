<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.webuipoc</groupId>
  <artifactId>web-ui-ssr-experiment-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>web-ui-ssr-experiment (Maven reactor)</name>
  <description>Aggregator + parent for the repo's Java modules.</description>

  <!--
    LAYOUT (Phase 4d — Connect-unary adapter extraction)
    ====================================================
    This is a single root pom that is BOTH the reactor aggregator (<modules>)
    and the shared parent (<parent> of each module). One command from here
    (`mvn -q -f pom.xml verify`) builds the reactor in dependency order:

        1. packages/java/connect-unary-adapter  (com.webuipoc:connect-unary-adapter)
        2. services/business-logic-java          (depends on the adapter artifact)

    Reactor ordering is derived from the inter-module dependency, not the
    <modules> listing, so the service always builds against a freshly built
    adapter jar — no version drift is possible because every shared version
    lives once, here, in <properties> + <dependencyManagement> + <pluginManagement>.

    BOM IMPORT ORDER IS LOAD-BEARING (first import wins, per artifact):
    grpc-bom and junit-bom MUST be imported BEFORE helidon-dependencies.
    Otherwise the Helidon BOM manages io.grpc:* transitives down to its own
    (older) line — below the protoc-gen-grpc-java codegen version and mixing
    grpc component versions, which grpc upstream does not support — and pulls
    junit down to Helidon's pinned line. This ordering was validated in the
    original single-module service pom and is preserved verbatim below.
  -->

  <modules>
    <module>packages/java/connect-unary-adapter</module>
    <module>services/business-logic-java</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Runtime versions shared across modules. Constraints (see
         services/business-logic-java/README.md):
         - protobuf-java must be >= the protoc gencode version (4.34.0 from
           nixpkgs protoc 34.0, enforced by RuntimeVersion.validateProtobufGencodeVersion)
         - grpc-java must be >= the protoc-gen-grpc-java plugin version (1.80.0 from nixpkgs) -->
    <version.helidon>4.4.1</version.helidon>
    <version.protobuf>4.35.1</version.protobuf>
    <version.grpc>1.82.2</version.grpc>
    <version.protovalidate>1.2.2</version.protovalidate>
    <version.junit>5.14.4</version.junit>
    <!-- ArchUnit: machine-enforced architecture rules (JUnit 5 flavour). Test
         scope only — it has no runtime consumers, so it does not participate in
         the runtime scope-mediation trap that governs the shared compile-scope
         pins above. -->
    <version.archunit>1.4.1</version.archunit>

    <!-- Compile-time DI, domain mapping and business-rule validation. Standalone
         (not managed by any imported BOM); used only by business-logic-java, but
         centralized here so all module versions live in one place. -->
    <version.avaje.inject>11.4</version.avaje.inject>
    <version.avaje.config>5.2</version.avaje.config>
    <!-- YAML parser avaje-config selects when present. Matches the version the
         helidon-dependencies BOM manages (and that protovalidate's dev.cel:cel
         already drags onto the runtime classpath transitively); pinned here so
         the direct entry (which wins over BOM imports) keeps the parser choice
         deterministic even if Helidon moves its managed line. -->
    <version.snakeyaml>2.5</version.snakeyaml>
    <version.avaje.validator>2.9</version.avaje.validator>
    <version.mapstruct>1.6.3</version.mapstruct>
    <!-- avaje-jsonb: compile-time JSON codec (no runtime reflection) used ONLY
         for the wide-event request-logging line emitted by the Connect adapter's
         WideEventFilter (task iq2.1). Runtime API + the annotation-processor
         generator (avaje-jsonb-generator) share this pin; BOM-unmanaged like the
         other avaje libs, centralized here so the adapter module depends on it
         version-less. -->
    <version.avaje.jsonb>3.14</version.avaje.jsonb>

    <!-- PostgreSQL persistence stack (validated pins, 2026-07). All BOM-unmanaged
         standalone libs; centralized here so the service module depends on them
         version-less. flyway-database-postgresql is a SEPARATE artifact (required
         since Flyway 10) that teaches flyway-core the jdbc:postgresql dialect. -->
    <version.flyway>12.11.0</version.flyway>
    <version.hikaricp>7.1.0</version.hikaricp>
    <version.pgjdbc>42.7.13</version.pgjdbc>
    <!-- jOOQ OSS: typed SQL DSL over the generated todos metamodel (task wdt.4).
         KNOWN ACCEPTED RISK: JDK 25 is officially certified only in the (as of
         2026-07 unreleased) jOOQ 3.22 line; 3.21.6 is pinned anyway because it is
         the current OSS GA and codegen + runtime were verified working on the
         devenv JDK 25 toolchain in this repo's build. UPGRADE TRIGGER: move to
         3.22 as soon as it GAs on Maven Central. -->
    <version.jooq>3.21.6</version.jooq>
    <!-- Testcontainers: TEST scope only (repository tests boot a real Postgres via
         podman). Like archunit, has no runtime consumers, so it does not
         participate in the runtime scope-mediation trap. -->
    <version.testcontainers>1.21.4</version.testcontainers>

    <!-- Build plugin versions (shared) -->
    <version.plugin.compiler>3.14.1</version.plugin.compiler>
    <version.plugin.surefire>3.5.6</version.plugin.surefire>
    <!-- Failsafe runs the *IT integration-test suite (real server + Testcontainers
         Postgres over HTTP) in the integration-test/verify phases, kept off the fast
         surefire unit path. Pinned to the surefire line: they share a release train. -->
    <version.plugin.failsafe>3.5.6</version.plugin.failsafe>
    <version.plugin.buildhelper>3.6.1</version.plugin.buildhelper>
    <version.plugin.jar>3.4.2</version.plugin.jar>
    <version.plugin.dependency>3.8.1</version.plugin.dependency>
    <version.plugin.exec>3.6.3</version.plugin.exec>
    <!-- jOOQ codegen against a REAL throwaway Postgres container: the plugin
         (org.testcontainers groupId, verified on Central) starts postgres via
         Testcontainers, applies this repo's actual Flyway migrations, and runs
         jOOQ's generator against the live catalog. 0.0.4 is the latest release
         (2024); its bundled tool versions are overridden — see pluginManagement. -->
    <version.plugin.tcjooq>0.0.4</version.plugin.tcjooq>
    <!-- Code style: Spotless drives palantir-java-format (120-col PALANTIR style)
         across both modules. palantir/google-java-format reach into jdk.compiler
         internals; Spotless' ModuleHelper opens those packages reflectively at
         runtime (since spotless-lib 2.26.2), so no add-exports JVM flags are
         needed on JDK 25 (the devenv toolchain; verified: spotless:check runs
         clean in the verify gate). -->
    <version.plugin.spotless>3.8.0</version.plugin.spotless>
    <version.palantir.javaformat>2.96.0</version.palantir.javaformat>

    <!-- Static analysis (task d4n.7). Plugins bundle OLD engines by default
         (maven-pmd-plugin 3.28.0 ships PMD 7.17; maven-checkstyle-plugin 3.6.0 ships
         Checkstyle 9.3), so BOTH the plugin AND the underlying engine are pinned
         explicitly — the engine is overridden via the plugin's <dependencies> in
         pluginManagement below, exactly like the jOOQ codegen plugin overrides its
         bundled tools. Engine versions verified latest-stable on Maven Central
         (2026-07) and confirmed to PARSE Java 25: PMD supports Java 25 since 7.16
         (default language level is Java 26 as of 7.21); Checkstyle supports Java 25
         (JEP 512/513) since 13.6. The devenv toolchain compiler release is 25. -->
    <version.plugin.pmd>3.28.0</version.plugin.pmd>
    <version.pmd>7.26.0</version.pmd>
    <version.plugin.checkstyle>3.6.0</version.plugin.checkstyle>
    <version.checkstyle>13.8.0</version.checkstyle>

    <!-- Error Prone + NullAway + jSpecify (task d4n.8). Error Prone 2.50.0 is the
         current GA (2026-06); it requires JDK 21+ and runs on the devenv JDK 25
         toolchain, but reaches into jdk.compiler internals, so the ten
         add-exports/add-opens flags in .mvn/jvm.config are REQUIRED on JDK 16+
         (they apply to the Maven JVM that hosts the in-process javac; fork=false).
         The -XDaddTypeAnnotationsToSymbol=true compilerArg (below) is required so
         type-use annotations are written to symbols on JDK 21+ — mandatory for
         NullAway JSpecify mode to read @Nullable use-site annotations.
         NullAway 0.13.7 needs Error Prone >= 2.36 and JDK 17+; its JSpecify mode
         needs JDK 22+ (satisfied by JDK 25). jSpecify 1.0.0 supplies @NullMarked /
         @Nullable. -->
    <version.errorprone>2.50.0</version.errorprone>
    <version.nullaway>0.13.7</version.nullaway>
    <version.jspecify>1.0.0</version.jspecify>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM ordering matters (first import wins per artifact): grpc-bom and
           junit-bom BEFORE helidon-dependencies. See the LAYOUT note above. -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${version.grpc}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.helidon</groupId>
        <artifactId>helidon-dependencies</artifactId>
        <version>${version.helidon}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Standalone (BOM-unmanaged) pins. protobuf-java is pinned above the
           versions grpc-bom / helidon would otherwise supply; managing it here
           forces the same line for direct and transitive uses in both modules. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${version.protobuf}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${version.protobuf}</version>
      </dependency>
      <dependency>
        <groupId>build.buf</groupId>
        <artifactId>protovalidate</artifactId>
        <version>${version.protovalidate}</version>
      </dependency>

      <!-- avaje-config: the service's external configuration owner (YAML defaults
           in application.yaml, profile files, env/system-property overrides).
           BOM-unmanaged like the other avaje libs; pinned here so the service
           module can depend on it version-less. Its YAML support uses a built-in
           parser (snakeyaml is an optional transitive we deliberately do NOT
           pull), so no extra dependency is needed for application.yaml. -->
      <dependency>
        <groupId>io.avaje</groupId>
        <artifactId>avaje-config</artifactId>
        <version>${version.avaje.config}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${version.snakeyaml}</version>
      </dependency>

      <!-- avaje-jsonb runtime: the compile-time JSON codec for the Connect
           adapter's wide-event log line (task iq2.1). BOM-unmanaged like the
           other avaje libs; pinned here so the adapter module depends on it
           version-less. The matching avaje-jsonb-generator is referenced (with
           the same version property) directly in the adapter's
           annotationProcessorPaths — annotation-processor artifacts are not
           dependencies, so they are not managed here. -->
      <dependency>
        <groupId>io.avaje</groupId>
        <artifactId>avaje-jsonb</artifactId>
        <version>${version.avaje.jsonb}</version>
      </dependency>

      <!-- Reactor-internal: lets business-logic-java depend on the adapter
           without repeating the version. -->
      <dependency>
        <groupId>com.webuipoc</groupId>
        <artifactId>connect-unary-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- jSpecify (task d4n.8): the @NullMarked / @Nullable annotations that
           NullAway reads in JSpecify mode. CLASS-retention annotations; a normal
           compile-scope dep in every module whose packages are @NullMarked. -->
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${version.jspecify}</version>
      </dependency>

      <!-- ArchUnit (test scope in the consuming modules). Standalone pin, like
           the other BOM-unmanaged libs; the archunit-junit5 artifact manages its
           own transitive graph, so a single version here keeps both modules aligned.
           Declared AFTER the BOM imports so the load-bearing junit-bom ordering
           (grpc/junit BEFORE helidon) is untouched. -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${version.archunit}</version>
      </dependency>

      <!-- PostgreSQL persistence stack. Runtime deps (pgjdbc, HikariCP, Flyway):
           the driver + pool + migrator the service uses at runtime. Declared AFTER
           the BOM imports so the load-bearing junit/grpc-before-helidon ordering is
           untouched (none of these are managed by those BOMs anyway). SCRAM-SHA-256
           auth (Postgres 17's default) needs no extra artifact: pgjdbc SHADES the
           scram client inside its own jar (org/postgresql/shaded/com/ongres/scram);
           its com.ongres.scram:scram-client pom dep is optional and NOT pulled.
           Verified: the libs-only runnable jar authenticates against a vanilla
           postgres:17-alpine with password_encryption=scram-sha-256. -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${version.pgjdbc}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${version.hikaricp}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${version.flyway}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-database-postgresql</artifactId>
        <version>${version.flyway}</version>
      </dependency>

      <!-- jOOQ runtime (the DSL the repository executes; the generated metamodel
           compiles against it). BOM-unmanaged standalone pin like the rest of the
           persistence stack; the codegen side is pinned to the SAME version via
           the testcontainers-jooq-codegen plugin's dependency overrides below, so
           generated code and runtime can never drift apart. -->
      <dependency>
        <groupId>org.jooq</groupId>
        <artifactId>jooq</artifactId>
        <version>${version.jooq}</version>
      </dependency>

      <!-- Testcontainers (test scope in the consuming module). Managed by explicit
           version property rather than the testcontainers-bom to avoid any BOM
           interaction with the load-bearing junit-bom ordering above. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${version.testcontainers}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>postgresql</artifactId>
        <version>${version.testcontainers}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${version.testcontainers}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.plugin.compiler}</version>
          <!-- Error Prone (task d4n.8). Shared compilerArgs inherited by BOTH
               modules (neither overrides <compilerArgs>). The error_prone_core (and
               nullaway) annotationProcessorPaths are declared per-module, NOT here:
               each module also lists its own processors (avaje/mapstruct in the
               service) and a pluginManagement processor list would be REPLACED, not
               merged, by the module's list — so we spell the full set out per module
               to make processor discovery explicit and drop-proof.

               -XDcompilePolicy=simple is mandatory for Error Prone. javac runs
               in-process (fork=false, the default); the required jdk.compiler
               add-exports/add-opens live in .mvn/jvm.config so they apply to the
               Maven JVM hosting javac. -XDaddTypeAnnotationsToSymbol=true is required
               on JDK 21+ for type-use annotations (NullAway JSpecify mode).
               -XepExcludedPaths drops every generated-sources tree (buf protobuf/grpc
               under <module>/generated-sources, jOOQ + avaje/mapstruct output under
               target/generated-sources) from Error Prone analysis — the same
               by-construction exclusion PMD/Checkstyle apply. -->
          <configuration>
            <compilerArgs>
              <arg>-XDcompilePolicy=simple</arg>
              <arg>--should-stop=ifError=FLOW</arg>
              <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
              <arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/generated-sources/.* -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked -XepOpt:NullAway:JSpecifyMode=true</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${version.plugin.surefire}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${version.plugin.failsafe}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${version.plugin.buildhelper}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${version.plugin.jar}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${version.plugin.dependency}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${version.plugin.exec}</version>
        </plugin>
        <!-- testcontainers-jooq-codegen: version + PLUGIN-CLASSPATH OVERRIDES live
             here; the execution + generator configuration (migrations location,
             target package/directory) is module-specific and lives in
             services/business-logic-java. The overrides matter (verified against
             the 0.0.4 plugin pom + sources jar):

             * jooq-codegen 3.18.3 is bundled -> overridden to ${version.jooq} so
               the generator that emits the sources is the EXACT version the code
               compiles and runs against (the plugin loads GenerationTool from its
               own classloader; the project's jooq dep would NOT win otherwise).
             * flyway-core 9.16.3 is bundled -> overridden to ${version.flyway}.
               This is not cosmetic: Flyway 9.16.x HARD-FAILS on PostgreSQL 16+
               ("Unsupported Database"), so the bundled line cannot migrate the
               postgres:17-alpine codegen container at all. The plugin's
               FlywayRunner API surface (FluentConfiguration
               .loadDefaultConfigurationFiles()/.configuration(Map),
               MigrateResult.migrationsExecuted; ConfigUtils/Location String
               constants are compile-time-inlined) was verified present in
               flyway-core 12.11.0 via javap. flyway-database-postgresql must ride
               along (dialect module, required since Flyway 10); flyway-mysql (a
               bundled 9.16.3 direct dep) is force-aligned too so Flyway's
               ServiceLoader plugin discovery never mixes 9.x plugin classes with
               the 12.x core.
             * testcontainers 1.19.1 (testcontainers/jdbc/postgresql) -> aligned to
               the repo-pinned ${version.testcontainers} (the line validated
               against the podman machine in wdt.3).
             * org.postgresql:postgresql is PROVIDED-scope in the plugin pom (i.e.
               absent from its resolved classpath by design — the plugin README
               requires consumers to supply the driver), so it is added here. -->
        <plugin>
          <groupId>org.testcontainers</groupId>
          <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
          <version>${version.plugin.tcjooq}</version>
          <dependencies>
            <dependency>
              <groupId>org.jooq</groupId>
              <artifactId>jooq-codegen</artifactId>
              <version>${version.jooq}</version>
            </dependency>
            <dependency>
              <groupId>org.flywaydb</groupId>
              <artifactId>flyway-core</artifactId>
              <version>${version.flyway}</version>
            </dependency>
            <dependency>
              <groupId>org.flywaydb</groupId>
              <artifactId>flyway-database-postgresql</artifactId>
              <version>${version.flyway}</version>
            </dependency>
            <dependency>
              <groupId>org.flywaydb</groupId>
              <artifactId>flyway-mysql</artifactId>
              <version>${version.flyway}</version>
            </dependency>
            <dependency>
              <groupId>org.testcontainers</groupId>
              <artifactId>testcontainers</artifactId>
              <version>${version.testcontainers}</version>
            </dependency>
            <dependency>
              <groupId>org.testcontainers</groupId>
              <artifactId>jdbc</artifactId>
              <version>${version.testcontainers}</version>
            </dependency>
            <dependency>
              <groupId>org.testcontainers</groupId>
              <artifactId>postgresql</artifactId>
              <version>${version.testcontainers}</version>
            </dependency>
            <dependency>
              <groupId>org.postgresql</groupId>
              <artifactId>postgresql</artifactId>
              <version>${version.pgjdbc}</version>
            </dependency>
          </dependencies>
        </plugin>
        <!-- Spotless: version + shared configuration + the verify-phase check
             binding live here in pluginManagement (repo convention: versions and
             reusable config are managed once in the parent). The plugin is then
             activated once in <build><plugins> below so every reactor module —
             parent included — inherits an active, identically-configured
             execution without repeating any XML per module.

             Scope is Spotless' java defaults: src/main/java/**/*.java and
             src/test/java/**/*.java ONLY. The build-helper generated-sources roots
             (generated-sources/protobuf, generated-sources/grpc) and anything under
             target/ are NOT matched by those globs, so buf/protoc output is never
             reformatted or even read. -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${version.plugin.spotless}</version>
          <configuration>
            <java>
              <!-- 120-col PALANTIR style is palantir-java-format's default. -->
              <palantirJavaFormat>
                <version>${version.palantir.javaformat}</version>
              </palantirJavaFormat>
              <!-- palantir sorts imports but does not drop unused ones. -->
              <removeUnusedImports/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- ============================================================= -->
        <!-- PMD + CPD (task d4n.7). Version + engine override + shared     -->
        <!-- config + verify-phase bindings live here in pluginManagement;  -->
        <!-- a bare reference in <build><plugins> below activates it for     -->
        <!-- every reactor module, mirroring the Spotless wiring.            -->
        <!--                                                                 -->
        <!-- ENGINE OVERRIDE: the plugin bundles PMD 7.17; the <dependencies>-->
        <!-- force pmd-core + pmd-java to ${version.pmd} (7.26) so the engine -->
        <!-- that parses the sources is the exact Java-25-capable line, not  -->
        <!-- the plugin's default. Same pattern as the jOOQ codegen plugin.  -->
        <!--                                                                 -->
        <!-- SCOPE: includeTests=true covers src/test/java (the plugin       -->
        <!-- default is main-only); excludeRoots drops every generated-source -->
        <!-- root (buf protobuf/grpc under generated-sources/, jOOQ under    -->
        <!-- target/generated-sources/jooq) so only hand-written code is     -->
        <!-- analysed. targetJdk=25 pins PMD's parse language level (the repo -->
        <!-- sets only maven.compiler.release, which the plugin does not read -->
        <!-- for language inference). Ruleset + duplicate detection are the  -->
        <!-- curated project files under tooling/. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${version.plugin.pmd}</version>
          <dependencies>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${version.pmd}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${version.pmd}</version>
            </dependency>
          </dependencies>
          <configuration>
            <targetJdk>25</targetJdk>
            <includeTests>true</includeTests>
            <printFailingErrors>true</printFailingErrors>
            <failOnViolation>true</failOnViolation>
            <minimumTokens>100</minimumTokens>
            <!-- The check/cpd-check goals fork the pmd/cpd REPORT mojos, which by
                 default render standalone HTML pages plus the full fluido site skin
                 (target/reports/{pmd,cpd}.html + js/css/fonts) even on a clean run.
                 skipEmptyReport=true skips that rendering when there are no
                 violations — the green path emits only the pmd.xml/cpd.xml the check
                 goals consume, keeping site-skin junk (which trips repo-wide JS
                 tooling) out of target/. On a FAILING run the HTML is still rendered,
                 which is exactly when a human wants it. linkXRef=false drops the
                 cross-reference links (we don't generate an xref site). -->
            <skipEmptyReport>true</skipEmptyReport>
            <linkXRef>false</linkXRef>
            <rulesets>
              <ruleset>${maven.multiModuleProjectDirectory}/tooling/pmd/ruleset.xml</ruleset>
            </rulesets>
            <!-- Generated code is never analysed (buf + jOOQ output). These roots
                 are added by build-helper / the jOOQ plugin at generate-sources; PMD
                 and CPD both honour excludeRoots. Paths that don't exist in a given
                 module (e.g. the adapter has no generated sources) are simply ignored. -->
            <excludeRoots>
              <excludeRoot>${project.basedir}/generated-sources/protobuf</excludeRoot>
              <excludeRoot>${project.basedir}/generated-sources/grpc</excludeRoot>
              <excludeRoot>${project.build.directory}/generated-sources/jooq</excludeRoot>
              <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
            </excludeRoots>
          </configuration>
          <executions>
            <!-- Bind to verify: `check` fails the build on any ruleset violation,
                 `cpd-check` fails it on any >=100-token duplicate block. -->
            <execution>
              <id>pmd-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
            <execution>
              <id>pmd-cpd-check</id>
              <phase>verify</phase>
              <goals>
                <goal>cpd-check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- ============================================================= -->
        <!-- Checkstyle (task d4n.7). Engine override + minimal shared      -->
        <!-- config + verify-phase binding; activated by a bare reference   -->
        <!-- in <build><plugins> below. The plugin bundles Checkstyle 9.3;  -->
        <!-- the <dependency> forces ${version.checkstyle} (13.8, Java-25-  -->
        <!-- capable). Source dirs are pinned to src/{main,test}/java ONLY   -->
        <!-- so generated roots (added to compileSourceRoots by build-helper -->
        <!-- / jOOQ) are never scanned. violationSeverity=error + the        -->
        <!-- config's severity=error make any finding fail the build. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${version.plugin.checkstyle}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${version.checkstyle}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/tooling/checkstyle/checkstyle.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>error</violationSeverity>
            <!-- Pin to hand-written sources only; overrides the plugin default
                 (all compileSourceRoots, which includes generated roots). -->
            <sourceDirectories>
              <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
            </sourceDirectories>
            <testSourceDirectories>
              <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
            </testSourceDirectories>
          </configuration>
          <executions>
            <execution>
              <id>checkstyle-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Activate Spotless for the whole reactor. A bare reference here (config
           and executions come from pluginManagement above) is inherited by both
           modules, so `mvn verify` runs spotless:check everywhere and fails the
           build on any unformatted src/{main,test}/java file. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>

      <!-- Activate PMD + CPD (task d4n.7) across the whole reactor. Config and
           executions are inherited from pluginManagement above, so `mvn verify`
           runs pmd:check + pmd:cpd-check on every module and fails on any violation. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>

      <!-- Activate Checkstyle (task d4n.7) across the whole reactor; config +
           execution inherited from pluginManagement above. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
