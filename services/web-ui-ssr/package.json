		"@tanstack/solid-form": "^1.33.0",
		"@tanstack/solid-query": "^5.62.7",
		"@tanstack/solid-router": "^1.170.17",
		"@tanstack/solid-router-ssr-query": "^1.167.1",
		"@web-ui-poc/rpc": "workspace:*",
		"arktype": "2.2.3",
		"hono": "^4.6.14",
		"loglayer": "^9.4.0",
		"pino": "^10.3.1",
		"solid-js": "^1.9.5"
	},
	"devDependencies": {
		"@hono/node-server": "^1.13.8",
