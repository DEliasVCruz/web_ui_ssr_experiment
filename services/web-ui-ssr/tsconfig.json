{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["bun-types"],
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@/*": ["./src/*"],
			"styled-system/*": ["./styled-system/*"]
		}
	},
	"include": ["src/**/*"],
	// src/sw.ts is a ServiceWorkerGlobalScope module — type-checked separately via
	// tsconfig.sw.json (WebWorker lib). Excluded here so its worker globals don't
	// collide with this project's DOM lib.
	"exclude": ["node_modules", "dist", "build", "src/sw.ts"]
}
