<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.webuipoc</groupId>
  <artifactId>business-logic-java</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>business-logic-java</name>
  <description>Java (Helidon SE) port of the business-logic Connect service — scaffold</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <mainClass>com.webuipoc.businesslogic.Main</mainClass>

    <!-- Runtime versions. Constraints (see README):
         - protobuf-java must be >= the protoc gencode version (4.34.0 from
           nixpkgs protoc 34.0, enforced by RuntimeVersion.validateProtobufGencodeVersion)
         - grpc-java must be >= the protoc-gen-grpc-java plugin version (1.80.0 from nixpkgs) -->
    <version.helidon>4.4.1</version.helidon>
    <version.protobuf>4.35.1</version.protobuf>
    <version.grpc>1.82.2</version.grpc>
    <version.junit>5.14.4</version.junit>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM ordering matters (first import wins per artifact): grpc-bom and
           junit-bom must come BEFORE helidon-dependencies, otherwise the
           Helidon BOM manages io.grpc:* transitives down to 1.73.0 (below the
           1.80.0 protoc-gen-grpc-java codegen version, and mixing grpc
           component versions, which grpc upstream does not support) and the
           junit api/params/engine down to 5.12.2. -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${version.grpc}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.helidon</groupId>
        <artifactId>helidon-dependencies</artifactId>
        <version>${version.helidon}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver</artifactId>
    </dependency>

    <!-- Generated protobuf messages + gRPC stubs (generated-sources/, emitted by `buf generate`) -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${version.protobuf}</version>
    </dependency>
    <!-- JsonFormat for the Connect adapter's application/json codec (version-aligned with protobuf-java) -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>${version.protobuf}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${version.grpc}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${version.grpc}</version>
      <exclusions>
        <!-- We pin protobuf-java explicitly above -->
        <exclusion>
          <groupId>com.google.protobuf</groupId>
          <artifactId>protobuf-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- SQLite storage for the TodoService port (same engine as the Bun
         service's bun:sqlite; see src/main/java/com/webuipoc/businesslogic/todo) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.2.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${version.junit}</version>
      <scope>test</scope>
    </dependency>
    <!-- In-process gRPC transport for exercising TodoServiceImpl through real
         generated stubs in unit tests -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <version>${version.grpc}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Version-less jar name so start commands and Dockerfiles stay stable -->
    <finalName>business-logic-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>

      <!-- Compile the buf-generated Java sources (gitignored; run `bun run generate`
           from the repo root first — see README) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-buf-generated-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/generated-sources/protobuf</source>
                <source>${project.basedir}/generated-sources/grpc</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>

      <!-- Runnable jar: Main-Class + Class-Path manifest pointing at libs/,
           populated by maven-dependency-plugin below. Start headlessly with
           `java -jar target/business-logic-java.jar` (Class-Path entries are
           resolved relative to the jar's own location). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${mainClass}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>libs/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Copy the runtime dependency jars next to the app jar (target/libs/)
           so the manifest Class-Path above resolves -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- `mvn exec:java` runs the server -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
