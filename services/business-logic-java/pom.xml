<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.webuipoc</groupId>
    <artifactId>web-ui-ssr-experiment-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>business-logic-java</artifactId>
  <packaging>jar</packaging>

  <name>business-logic-java</name>
  <description>Java (Helidon SE) port of the business-logic Connect service</description>

  <properties>
    <mainClass>com.webuipoc.businesslogic.Main</mainClass>
  </properties>

  <!-- Shared versions, BOM imports (load-bearing order) and plugin versions are
       managed by the root parent pom (../../pom.xml). This module only declares
       what it directly uses; the Connect-unary adapter (com.webuipoc:connect-unary-adapter)
       carries the Connect/protovalidate machinery and its transitive deps
       (protobuf-java-util, protovalidate, ...). -->

  <dependencies>
    <!-- The service-agnostic Connect-unary HTTP adapter (reactor module). -->
    <dependency>
      <groupId>com.webuipoc</groupId>
      <artifactId>connect-unary-adapter</artifactId>
    </dependency>

    <!-- jSpecify @NullMarked / @Nullable (task d4n.8); read by NullAway in
         JSpecify mode. Version from the parent's dependencyManagement. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver</artifactId>
    </dependency>

    <!-- Framework & out-of-request logging as JSON (task iq2.2). Three parts,
         all versions from the helidon-dependencies / slf4j BOMs (parent pom):

         * helidon-logging-common (compile): Main directly calls
           LogConfig.configureRuntime() to load logging.properties BEFORE the
           Flyway migrations run in the DI-graph build. Already on the classpath
           transitively via helidon-webserver; declared explicitly because we
           reference it in source ("declare what you directly use").
         * helidon-logging-jul (runtime): the JUL LoggingProvider SPI that
           actually reads the classpath logging.properties, plus the
           HelidonConsoleHandler + HelidonJsonFormatter named there. Referenced
           only by name (reflection) from logging.properties and discovered via
           ServiceLoader, so runtime scope is correct; copy-dependencies
           (includeScope=runtime) keeps it in target/libs. NOT the rejected
           jul-to-slf4j bridge — this is Helidon's own JUL machinery.
         * slf4j-jdk14 (runtime): the SLF4J -> JUL binding. HikariCP (and any
           pure-SLF4J dep) logs via SLF4J; with no binding present those records
           hit the NOP logger and are SILENTLY LOST (verified: Hikari pool +
           connection-failure logs never appeared, and slf4j-api printed its
           "No SLF4J providers were found" warning at boot). Routing SLF4J -> JUL
           funnels them into the same JSON stream and silences that warning. This
           is the OPPOSITE direction of the rejected jul-to-slf4j+logback bridge:
           JUL stays the single sink. Runtime scope (a logging binding is never a
           compile dep); BOM-managed to match slf4j-api 2.0.17. -->
    <dependency>
      <groupId>io.helidon.logging</groupId>
      <artifactId>helidon-logging-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.logging</groupId>
      <artifactId>helidon-logging-jul</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Generated protobuf messages + gRPC stubs (generated-sources/, emitted by
         `buf generate`); used directly by the mapper and the gRPC bridge. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <exclusions>
        <!-- protobuf-java is pinned via the parent's dependencyManagement -->
        <exclusion>
          <groupId>com.google.protobuf</groupId>
          <artifactId>protobuf-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- PostgreSQL persistence for the TodoService port (see
         src/main/java/com/webuipoc/businesslogic/todo). All three are runtime deps
         (default/compile scope, NEVER test — the scope-mediation trap): the pgjdbc
         driver, the HikariCP pool, and Flyway (core + the separate postgresql
         dialect module required since Flyway 10). Versions from the parent's
         dependencyManagement. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- jOOQ runtime: the typed DSL TodoRepository executes, and the library the
         generated metamodel (target/generated-sources/jooq, emitted by the hermetic
         codegen — scripts/jooq-codegen.sh + the `jooq-codegen` profile below)
         compiles against. Runtime dep (default scope, NEVER test — the
         scope-mediation trap). Version from the parent's dependencyManagement; the
         codegen runs jooq-codegen-maven at the same version, so generated code and
         runtime cannot drift. -->
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq</artifactId>
    </dependency>

    <!-- Compile-time dependency injection (no runtime reflection/proxies): the
         avaje-inject-generator (wired in annotationProcessorPaths below) emits
         the DI wiring at build time; this is the runtime API + generated
         module. -->
    <dependency>
      <groupId>io.avaje</groupId>
      <artifactId>avaje-inject</artifactId>
      <version>${version.avaje.inject}</version>
    </dependency>

    <!-- External service configuration owner: application.yaml defaults, profile
         files (application-<profile>.yaml) and env/system-property overrides.
         Version managed by the parent's dependencyManagement. Wired into the DI
         graph via a typed ServiceConfig holder (see config/ServiceConfig +
         AppFactory); the server bootstrap bridges its values into the Helidon
         WebServer builder. -->
    <dependency>
      <groupId>io.avaje</groupId>
      <artifactId>avaje-config</artifactId>
    </dependency>

    <!-- Deterministic YAML parsing for avaje-config: snakeyaml is an OPTIONAL
         avaje-config dep, but avaje-config prefers YamlLoaderSnake whenever
         snakeyaml is on the classpath — and it already is, transitively at
         runtime scope (connect-unary-adapter -> protovalidate -> dev.cel:cel).
         Without this explicit declaration the production parser choice would
         silently flip to the built-in simple parser if that transitive ever
         disappeared. Declared at default (compile) scope, NEVER test: a direct
         test-scope declaration would win dependency mediation over the
         transitive runtime scope and drop the jar from target/libs (the repo's
         documented scope-mediation trap). Version from the parent's
         dependencyManagement. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- Business-rule validation on the domain command records (avaje-validator
         runtime + the standard constraint annotations, e.g. @NotBlank). Wire
         validation (protovalidate) stays in the Connect adapter; these rules are
         the domain layer's own (e.g. non-blank-after-trim title). -->
    <dependency>
      <groupId>io.avaje</groupId>
      <artifactId>avaje-validator</artifactId>
      <version>${version.avaje.validator}</version>
    </dependency>
    <dependency>
      <groupId>io.avaje</groupId>
      <artifactId>avaje-validator-constraints</artifactId>
      <version>${version.avaje.validator}</version>
    </dependency>

    <!-- MapStruct: proto <-> domain command mapping and domain -> proto mapping.
         Compile-time generated (mapstruct-processor in annotationProcessorPaths). -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${version.mapstruct}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit: encodes this module's layering (domain purity, JDBC/StreamObserver
         confinement, Helidon-in-bootstrap-only) as failing JUnit tests. Test scope. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-process gRPC transport for exercising TodoGrpcBridge through real
         generated stubs in unit tests -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers: the DB-touching repository tests boot a real Postgres
         container (via the podman env wired in wdt.2; ryuk disabled by env). Test
         scope only. The postgresql module provides PostgreSQLContainer; it uses
         the app's own pgjdbc driver (already on the runtime classpath). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JsonFormat in the adapter integration tests (ConnectUnaryAdapterTest):
         declared explicitly rather than leaning on the transitive copy the
         connect-unary-adapter dependency happens to bring in. Deliberately
         default (compile) scope, NOT test scope: a direct test-scope
         declaration wins dependency mediation over the adapter's transitive
         compile-scope dep and silently drops the jar from target/libs — which
         breaks the adapter's application/json codec at runtime (verified: with
         test scope, copy-dependencies omits it). Version from the parent's
         dependencyManagement. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
    </dependency>
    <!-- Gson: used directly by FrameworkLoggingFormatTest (parsing the JSON log
         lines the HelidonJsonFormatter emits) — declared explicitly instead of
         leaning on the transitive copy protobuf-java-util brings in. Deliberately
         default (compile) scope, NOT test scope, even though only a test uses it
         directly: gson is a RUNTIME-scope transitive of protobuf-java-util (its
         JsonFormat — the Connect adapter's application/json codec — parses via
         Gson), and a direct test-scope declaration would win dependency mediation
         and drop the jar from target/libs, breaking the runtime jar — the same
         documented scope-mediation trap as protobuf-java-util/snakeyaml above.
         Version managed by the helidon-dependencies BOM (version.lib.gson). -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- Version-less jar name so start commands and Dockerfiles stay stable -->
    <finalName>business-logic-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Once ANY annotation processor is declared here, javac stops
               auto-discovering processors from the compile classpath, so every
               processor the build needs must be listed explicitly: avaje-inject
               (DI wiring), avaje-validator (validation adapters + generated
               component), and MapStruct (mapper impls). Order does not matter to
               javac; all run each round. -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.avaje</groupId>
              <artifactId>avaje-inject-generator</artifactId>
              <version>${version.avaje.inject}</version>
            </path>
            <path>
              <groupId>io.avaje</groupId>
              <artifactId>avaje-validator-generator</artifactId>
              <version>${version.avaje.validator}</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${version.mapstruct}</version>
            </path>
            <!-- Error Prone + NullAway (task d4n.8). Added alongside the existing
                 processors: once any processor is listed, javac stops classpath
                 auto-discovery, so Error Prone's core (which hosts the NullAway
                 bug-checker plugin) must be listed here explicitly. Order is
                 irrelevant to javac; all run each round. Versions from the parent. -->
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${version.errorprone}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${version.nullaway}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Compile the buf-generated Java sources (gitignored; run `bun run generate`
           from the repo root first — see README) plus the jOOQ metamodel emitted
           by the hermetic codegen below. The jOOQ sources land under
           target/generated-sources/jooq; unlike the old testcontainers-jooq plugin
           (which registered its own compile source root in-session), the hermetic
           codegen produces them from a NESTED maven invocation, so this outer build
           must add that directory as a source root itself. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-buf-generated-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/generated-sources/protobuf</source>
                <source>${project.basedir}/generated-sources/grpc</source>
                <source>${project.build.directory}/generated-sources/jooq</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- jOOQ codegen against the REAL schema (task wdt.4, made hermetic in 2pk.6):
           at generate-sources the exec-maven-plugin below runs scripts/jooq-codegen.sh,
           which starts an EPHEMERAL PostgreSQL from the devenv/nix environment (initdb
           + pg_ctl on a loopback port and a unix socket in a private temp dir — NO
           container runtime, NO Docker socket), applies THIS module's actual Flyway
           migrations, runs jOOQ's generator against the live catalog, then tears the
           database down. The Flyway + jOOQ steps run through a nested maven invocation
           of the `jooq-codegen` profile (see <profiles> below), so their versions stay
           pinned by the reactor and generated code can never drift from the runtime
           jOOQ/Flyway pins. Consequences, unchanged from the container approach except
           for the runtime dependency:
             * `mvn verify` (and even `mvn compile`) runs the codegen at
               generate-sources, but now needs ONLY the postgres binaries on PATH — no
               Docker socket. This is what makes a pure Nix build of this module
               possible (2pk.3); the same script runs in a Nix sandbox.
             * Generated sources land under target/generated-sources/jooq — inside
               target/, so gitignored by the existing target/ entry and invisible to
               Spotless (globs cover src/{main,test}/java only). Because the codegen
               runs in a nested maven session, its addCompileSourceRoot does NOT reach
               this build, so the build-helper add-source above registers the directory
               for compilation explicitly.
             * TARGET PACKAGE com.webuipoc.jooq is chosen DELIBERATELY outside both
               ArchUnit analysis roots (com.webuipoc.businesslogic here,
               com.webuipoc.connect in the adapter), so no architecture rule can fire
               ON generated classes — the same by-construction exclusion the
               buf-generated todo.v1 sources rely on. Rules still police DEPENDENCIES
               ON it (see ArchitectureTest's jOOQ confinement rule).
             * flyway_schema_history is excluded from generation: it is Flyway's
               bookkeeping table, not part of the domain schema. -->
      <!-- exec-maven-plugin: the `generate-jooq-sources` execution drives the
           hermetic codegen at generate-sources; the plugin-level <mainClass> serves
           the CLI `mvn exec:java` used to run the server (see ## Run in the README). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>${mainClass}</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>generate-jooq-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${project.basedir}/scripts/jooq-codegen.sh</executable>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- Failsafe runs the integration suite (*IT): it boots the REAL service
           (Main.start(): full avaje-inject graph + Flyway + Helidon WebServer on
           an ephemeral port) against a Testcontainers postgres:17-alpine and
           exercises it over raw HTTP. Bound to the integration-test/verify phases
           so `mvn verify` runs it after the fast surefire unit tests; the version
           is pinned in the parent's pluginManagement. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Runnable jar: Main-Class + Class-Path manifest pointing at libs/,
           populated by maven-dependency-plugin below. Start headlessly with
           `java -jar target/business-logic-java.jar` (Class-Path entries are
           resolved relative to the jar's own location). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${mainClass}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>libs/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Copy the runtime dependency jars next to the app jar (target/libs/)
           so the manifest Class-Path above resolves. includeScope=runtime pulls
           reactor-internal deps too (connect-unary-adapter.jar), so the runnable
           jar is self-contained. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- avaje-inject build support: the `provides` goal writes the module
           metadata the annotation processor reads for external-dependency
           detection (the <?m2e execute?> PI makes it run in Eclipse/VS Code
           incremental builds too) -->
      <plugin>
        <groupId>io.avaje</groupId>
        <artifactId>avaje-inject-maven-plugin</artifactId>
        <version>${version.avaje.inject}</version>
        <executions>
          <execution>
            <?m2e execute?>
            <phase>process-sources</phase>
            <goals>
              <goal>provides</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- jooq-codegen: NOT part of the default lifecycle. Activated only by the
       hermetic codegen script (scripts/jooq-codegen.sh, driven by exec-maven-plugin
       at generate-sources) via a nested `mvn -Pjooq-codegen
       org.flywaydb:flyway-maven-plugin:migrate org.jooq:jooq-codegen-maven:generate`
       against the ephemeral Postgres the script starts. Keeping the config in a
       profile (rather than bound to a phase) means the outer `mvn verify` never
       double-runs Flyway/jOOQ, and the versions stay pinned to the reactor's
       ${version.flyway}/${version.jooq}/${version.pgjdbc} — so generated code can
       never drift from the runtime pins. The jdbc.* coordinates are supplied by the
       script as -D properties (loopback URL + trust auth). -->
  <profiles>
    <profile>
      <id>jooq-codegen</id>
      <build>
        <plugins>
          <!-- Apply the module's real Flyway migrations to the ephemeral DB.
               flyway-database-postgresql rides along on the plugin classpath: it is
               the jdbc:postgresql dialect module, required since Flyway 10. -->
          <plugin>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-maven-plugin</artifactId>
            <version>${version.flyway}</version>
            <configuration>
              <url>${jooq.codegen.jdbc.url}</url>
              <user>${jooq.codegen.jdbc.user}</user>
              <password>${jooq.codegen.jdbc.password}</password>
              <locations>
                <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
              </locations>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${version.flyway}</version>
              </dependency>
            </dependencies>
          </plugin>
          <!-- jOOQ generator against the live catalog. The generator config is
               IDENTICAL to the retired testcontainers-jooq plugin's (PostgresDatabase,
               public schema, exclude flyway_schema_history, target package
               com.webuipoc.jooq, target dir target/generated-sources/jooq) so the
               emitted sources are unchanged. The pgjdbc driver is added to the plugin
               classpath (jooq-codegen-maven does not bundle a JDBC driver). -->
          <plugin>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen-maven</artifactId>
            <version>${version.jooq}</version>
            <configuration>
              <jdbc>
                <driver>org.postgresql.Driver</driver>
                <url>${jooq.codegen.jdbc.url}</url>
                <user>${jooq.codegen.jdbc.user}</user>
                <password>${jooq.codegen.jdbc.password}</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.postgres.PostgresDatabase</name>
                  <inputSchema>public</inputSchema>
                  <includes>.*</includes>
                  <excludes>flyway_schema_history</excludes>
                </database>
                <target>
                  <packageName>com.webuipoc.jooq</packageName>
                  <directory>${project.build.directory}/generated-sources/jooq</directory>
                </target>
              </generator>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${version.pgjdbc}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
