{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// These exports are consumed within their own module (module-level singletons
	// / internal fetch-base-URL constants in e2e/fixtures.ts and the Ark UI toaster
	// store in toast.tsx). They are legitimately not cross-module imports, so knip's
	// "unused export" report is a false positive here — suppress it globally rather
	// than un-exporting working code.
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			// tooling/eslint/ci.ts is never imported — it is loaded by the CLI via
			// `eslint --config tooling/eslint/ci.ts` (devenv `ci:eslint` task), so knip
			// can't infer it as reachable. (eslint.config.ts + tooling/eslint/base.ts are
			// auto-detected by knip's ESLint plugin.)
			"entry": ["tooling/eslint/ci.ts"],
			"ignoreDependencies": [
				// buf codegen plugins, invoked by buf as `local:` protoc plugins in
				// buf.gen.yaml (not importable JS) — see `bun run generate`.
				"@bufbuild/protoc-gen-es",
				"@connectrpc/protoc-gen-connect-query",
				// Solid HMR transform. @rsbuild/plugin-solid injects the solid-refresh
				// babel plugin for the dev client build; rsbuild.config.ts references it
				// only by string (to strip it from the SSR build). Never a static import,
				// so knip can't see the usage.
				"solid-refresh"
			]
		},
		"packages/rpc": {
			// This package is nothing but buf-generated code under gen/ (gitignored, so
			// knip can't scan it — a `gen/**/*.ts` project glob resolves to zero files).
			// The generated modules (todo_pb.ts) import @bufbuild/protobuf; it is a real
			// runtime dependency, invisible to knip only because the code is generated.
			"ignoreDependencies": ["@bufbuild/protobuf"]
		}
	}
}
