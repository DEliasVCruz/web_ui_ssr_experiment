{
	"name": "web-ui-poc",
	"version": "0.0.1",
	"private": true,
	"packageManager": "bun@1.3.10",
	"workspaces": {
		"packages": [
			"packages/*",
			"services/*"
		],
		"catalog": {
			"@bufbuild/protobuf": "^2.11.0",
			"@connectrpc/connect": "^2.1.1",
			"@connectrpc/connect-web": "^2.1.1",
			"typescript": "^5.7.2"
		}
	},
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"generate": "buf generate && bun run scripts/wrap-jsonschema.ts",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "bun run --filter '*' typecheck",
		"lint:eslint": "bun run --filter '*' lint:eslint",
		"lint:eslint:fix": "bun run --filter '*' lint:eslint -- --fix",
		"lint:deps": "syncpack lint",
		"fix:deps": "syncpack fix",
		"lint:workspaces": "sherif -r multiple-dependency-versions -r unsync-similar-dependencies -r packages-without-package-json --fail-on-warnings",
		"lint:knip": "knip",
		"lint:boundaries": "depcruise services packages --config .dependency-cruiser.cjs",
		"lint:hygiene": "bun run lint:deps && bun run lint:workspaces && bun run lint:knip && bun run lint:boundaries"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.12",
		"@bufbuild/buf": "^1.47.2",
		"@bufbuild/protoc-gen-es": "^2.11.0",
		"@connectrpc/protoc-gen-connect-query": "^2.0.1",
		"@pandacss/eslint-plugin": "^0.3.2",
		"@tanstack/eslint-plugin-query": "^5.99.2",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"dependency-cruiser": "^18.1.0",
		"eslint": "^10.2.1",
		"eslint-plugin-solid": "^0.14.5",
		"knip": "^6.27.0",
		"sherif": "^1.13.0",
		"solid-refresh": "^0.7.8",
		"syncpack": "^15.3.2",
		"typescript": "catalog:",
		"typescript-eslint": "^8.59.0"
	}
}
